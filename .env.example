BOT_TOKEN=YOUR_BOT_TOKEN

DATABASE_URL=postgresql+asyncpg://botuser_dev:devpassword@localhost:5432/botdb_dev

WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8082
WEBHOOK_PATH=/yookassa/webhook
WEBHOOK_URL=https://your-domain.example/yookassa/webhook

YOOKASSA_SHOP_ID=YOUR_SHOP_ID
YOOKASSA_SECRET_KEY=YOUR_SECRET_KEY

PANEL_ORIGIN=http://127.0.0.1:9999
PANEL_USERNAME=dev_disabled
PANEL_PASSWORD=dev_disabled
PANEL_PATH=/your-panel-path
PANEL_ENABLED=true

ENABLE_REFERRAL=false
ENABLE_LAUNCH_OFFER=true

FREE_TRAFFIC_LIMIT_MB=3072
PAID_PRICE_1M_RUB=249
PAID_DISCOUNT_6M_PERCENT=15
PAID_DISCOUNT_12M_PERCENT=35

LAUNCH_OFFER_LIMIT_USERS=10
LAUNCH_OFFER_PRICE_1M_RUB=100
LAUNCH_OFFER_PRICE_6M_RUB=600
LAUNCH_OFFER_PRICE_12M_RUB=1200

OFFER_URL=https://example.com/oferta
PRIVACY_URL=https://example.com/privacy
RULES_URL=https://example.com/rules
NEWS_CHANNEL_URL=https://t.me/example_channel

SUPPORT_USERNAME=@example_support
SUPPORT_URL=https://t.me/example_support

APP_ENV=dev
DEV_MODE=false


SUBSCRIPTION_PUBLIC_BASE_URL=http://127.0.0.1:8088
SUBSCRIPTION_HOST=127.0.0.1
SUBSCRIPTION_PORT=8088
SUBSCRIPTION_REQUEST_TIMEOUT=15

# Comma-separated Telegram IDs allowed to use owner-only admin commands.
ADMIN_TELEGRAM_IDS=

# Comma-separated Telegram IDs allowed to open the internal read-only Admin Mini App.
# This must contain numeric Telegram IDs only, never usernames.
ADMIN_MINIAPP_TELEGRAM_IDS=
ADMIN_MINIAPP_INITDATA_MAX_AGE_SECONDS=86400
